# Copy to backend/.env and fill in (or run with env vars).
# For docker compose, use the same file at the repo root as env_file.

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# 12 Groq keys, auto-detected as GROQ_KEY_1 through GROQ_KEY_12
# Distribute across 4 models: llama-3.3-70b, compound, compound-mini, llama-3.1-8b
GROQ_API_KEY_1=your_groq_key_here
GROQ_API_KEY_2=your_groq_key_here

# Optional: require X-API-Key on non-health endpoints, rate limit per IP/min
CODEGRAPH_API_KEY=
CODEGRAPH_RATE_LIMIT=120
